server {
    listen 8080;
    server_name _;
    server_tokens off;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    client_body_timeout ${PROXY_TIMEOUT_SECONDS}s;

    location /static/ {
        alias /srv/static/;
        add_header X-Content-Type-Options nosniff always;
        expires ${STATIC_CACHE_TTL};
        add_header Cache-Control "${STATIC_CACHE_CONTROL}" always;
    }

    location ~ ^/static/.*\.mjs$ {
        root /srv;
        types { application/javascript mjs; }
        add_header X-Content-Type-Options nosniff always;
        expires ${STATIC_CACHE_TTL};
        add_header Cache-Control "${STATIC_CACHE_CONTROL}" always;
    }

    location / {
        # Runtime resolution survives replacement of the app container.
        resolver 127.0.0.11 valid=10s;
        set $backend http://app:8000;
        proxy_pass $backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
        proxy_connect_timeout 10s;
        proxy_read_timeout ${PROXY_TIMEOUT_SECONDS}s;
        proxy_send_timeout ${PROXY_TIMEOUT_SECONDS}s;
        proxy_redirect off;
    }
}
