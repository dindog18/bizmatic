#!/bin/sh
set -eu
case "$REQUEST_TIMEOUT_SECONDS" in
  ''|*[!0-9]*) echo 'REQUEST_TIMEOUT_SECONDS must be positive seconds' >&2; exit 1;;
esac
[ "$REQUEST_TIMEOUT_SECONDS" -gt 0 ]
case "$PUBLIC_SCHEME" in http|https) ;; *) echo 'PUBLIC_SCHEME must be http or https' >&2; exit 1;; esac
export PROXY_TIMEOUT_SECONDS="$((REQUEST_TIMEOUT_SECONDS + 30))"
