# Generated values are unquoted: Compose's raw env_file passes them literally.
DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8005,http://127.0.0.1:8005
DJANGO_TIME_ZONE=Asia/Manila
BIZMATIC_BIND_ADDRESS=127.0.0.1
BIZMATIC_PORT=8005
# For a trusted TLS terminator in front of the Compose proxy, use https and true.
PUBLIC_SCHEME=http
DJANGO_SECURE_COOKIES=false
# Host paths are selected by bizmatic init. They are bind-mounted at the SAME
# absolute paths inside Docker, so native/Docker uploads remain compatible.
BIZMATIC_DATA_DIR=__DATA_DIR__
BIZMATIC_DATABASE_FILE=__DATABASE_FILE__
BIZMATIC_UPLOADS_DIR=__UPLOADS_DIR__
BIZMATIC_KEY_DIR=__KEY_DIR__
BIZMATIC_UID=__UID__
BIZMATIC_GID=__GID__
# Optional PostgreSQL mode (bizmatic init --database postgres):
DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=bizmatic
# DB_USER=bizmatic
# DB_PASSWORD=provide-your-postgresql-password
WEB_WORKERS=1
APP_MEMORY_LIMIT=2g
APP_CPUS=2.0
# Nginx derives a proxy timeout 30 seconds longer than this worker timeout.
REQUEST_TIMEOUT_SECONDS=600
CLIENT_MAX_BODY_SIZE=128m

# Host Ollama on Ubuntu needs a bridge-reachable listener; see deploy/README.md.
# Or use the optional Compose Ollama service and change the URL to http://ollama:11434.
DOC_EXTRACTION_LLM_PROVIDER=ollama
DOC_EXTRACTION_OLLAMA_BASE_URL=http://host.docker.internal:11434
DOC_EXTRACTION_OLLAMA_MODEL=qwen3-vl
DOC_EXTRACTION_LLM_TIMEOUT_SECONDS=120
DOC_EXTRACTION_MAX_CONCURRENCY=3
ROUTER_LLM_PROVIDER=ollama
ROUTER_OLLAMA_MODEL=qwen3-vl
ROUTER_LLM_TIMEOUT_SECONDS=120
ACCOUNTS_PAYABLE_LLM_PROVIDER=ollama
ACCOUNTS_PAYABLE_OLLAMA_MODEL=qwen3-vl
ACCOUNTS_PAYABLE_LLM_TIMEOUT_SECONDS=120
ACCOUNTS_RECEIVABLE_LLM_PROVIDER=ollama
ACCOUNTS_RECEIVABLE_OLLAMA_MODEL=qwen3-vl
ACCOUNTS_RECEIVABLE_LLM_TIMEOUT_SECONDS=120
CONFIG_ASSISTANT_LLM_PROVIDER=ollama
CONFIG_ASSISTANT_OLLAMA_MODEL=qwen3-vl
CONFIG_ASSISTANT_LLM_TIMEOUT_SECONDS=120
# Add provider keys/model/URL overrides from bizmatic_django/.env.example as needed.
# This file is a Compose runtime file; do not commit generated .env.docker secrets.
