# Loaded automatically by Django and extraction services.
# Explicit shell/PyCharm environment variables take precedence over this file.
# Restart running processes after editing this file.
# bizmatic_django/bizmatic_django/settings.py
## Django Top Configurations
# Replace the secret key with a unique, randomly generated value.
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
# Enable debug tools only during local development.
DJANGO_DEBUG=True
# Comma-separated host names allowed to serve this Django app.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Django time zone, for example UTC or Asia/Manila.
DJANGO_TIME_ZONE=UTC

## Database Target
# SQLite works with the base requirements and needs no database server.
DB_ENGINE=django.db.backends.sqlite3
# Omit DB_NAME to use bizmatic_django/db.sqlite3, independent of working directory.
# DB_NAME=/absolute/path/to/development.sqlite3
# For PostgreSQL, create the database and replace the SQLite settings above.
# The PostgreSQL driver is included in requirements.txt.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=bizmatic
# DB_USER=bizmatic_user
# DB_PASSWORD=replace-with-your-database-password
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ==========================================

# bizmatic_django/document_extraction/services/storage.py
## File Path
# Local directory where uploaded files are stored.
LOCAL_FILE_STORAGE_PATH=./storage_file

# ==========================================

# bizmatic_django/document_extraction/services/llm.py
## LLM Provider
# Select one provider or a comma-separated list; listed providers run concurrently.
DOC_EXTRACTION_LLM_PROVIDER=ollama

## Concurrent Extraction
# document_extraction/services/llm.py — extraction concurrency.
# Maximum simultaneous file writes/extractions, and LLM calls across each batch.
DOC_EXTRACTION_MAX_CONCURRENCY=5

## LLM Request Timeout
# Positive seconds for each HTTP connect/read/write/pool wait across all providers.
# This is not a total generation deadline. Default: 120; increase for slower local models.
DOC_EXTRACTION_LLM_TIMEOUT_SECONDS=120

## Terminal Logging
# bizmatic_django/settings.py — terminal logger configuration.
# INFO shows progress; DEBUG, WARNING and ERROR adjust terminal verbosity.
DOC_EXTRACTION_LOG_LEVEL=INFO

## OpenAI
# API key and vision-capable model name.
DOC_EXTRACTION_OPENAI_API_KEY=replace-with-your-openai-api-key
DOC_EXTRACTION_OPENAI_MODEL=gpt-4o

## Anthropic
# API key and current Claude vision model name.
DOC_EXTRACTION_ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
DOC_EXTRACTION_ANTHROPIC_MODEL=claude-sonnet-5-5

## Google Gemini
# Gemini API key and vision-capable model name.
DOC_EXTRACTION_GOOGLE_API_KEY=replace-with-your-google-api-key
DOC_EXTRACTION_GOOGLE_MODEL=gemini-3.8-flash

## Mistral OCR
# API key and OCR model name. This provider requires an image or PDF file.
DOC_EXTRACTION_MISTRAL_API_KEY=replace-with-your-mistral-api-key
DOC_EXTRACTION_MISTRAL_OCR_MODEL=mistral-ocr-latest

## Ollama
# Local Ollama server URL and a vision model installed on that server.
DOC_EXTRACTION_OLLAMA_BASE_URL=http://localhost:11434
DOC_EXTRACTION_OLLAMA_MODEL=qwen3-vl

## Alibaba Cloud Model Studio
# DashScope key and Qwen vision model. Override the base URL for your region if needed.
DOC_EXTRACTION_DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DOC_EXTRACTION_ALIBABA_MODEL=qwen3-vl-plus
DOC_EXTRACTION_ALIBABA_BASE_URL=

## DeepSeek
# API key, vision model, and optional API base URL override.
DOC_EXTRACTION_DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DOC_EXTRACTION_DEEPSEEK_MODEL=deepseek-flash
DOC_EXTRACTION_DEEPSEEK_BASE_URL=https://api.deepseek.com

# ==========================================
# DOCUMENT ROUTER
# router/services/llm.py — text-only LLM selection and provider settings.
## LLM Provider
# Choose one chat provider: openai, anthropic, google, ollama, alibaba, or deepseek.
ROUTER_LLM_PROVIDER=ollama

## Concurrent Routing
# router/services/execution.py — maximum simultaneous document LLM calls.
ROUTER_MAX_CONCURRENCY=5

## LLM Request Timeout
# router/services/llm.py — positive seconds for each HTTP connect/read/write/pool wait.
ROUTER_LLM_TIMEOUT_SECONDS=120

## Terminal Logging
# bizmatic_django/settings.py — INFO, DEBUG, WARNING, or ERROR.
ROUTER_LOG_LEVEL=INFO

# Provider sections follow the DOC_EXTRACTION_* naming convention.
# Each provider has its own model. Blank keys/URLs reuse the corresponding
# DOC_EXTRACTION_* values through document_extraction/services/llm.py.

## OpenAI
ROUTER_OPENAI_API_KEY=replace-with-your-openai-api-key
ROUTER_OPENAI_MODEL=gpt-4o
ROUTER_OPENAI_BASE_URL=

## Anthropic
ROUTER_ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ROUTER_ANTHROPIC_MODEL=claude-sonnet-5-5
ROUTER_ANTHROPIC_BASE_URL=

## Google Gemini
ROUTER_GOOGLE_API_KEY=replace-with-your-google-api-key
ROUTER_GOOGLE_MODEL=gemini-3.8-flash
ROUTER_GOOGLE_BASE_URL=

## Ollama
ROUTER_OLLAMA_MODEL=qwen3-vl
ROUTER_OLLAMA_BASE_URL=

## Alibaba Cloud Model Studio
ROUTER_DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
ROUTER_ALIBABA_MODEL=qwen3-vl-plus
ROUTER_ALIBABA_BASE_URL=

## DeepSeek
ROUTER_DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
ROUTER_DEEPSEEK_MODEL=deepseek-flash
ROUTER_DEEPSEEK_BASE_URL=

## Routing Execution Limits
# router/services/execution.py — reject oversized selections/text without truncation.
ROUTER_MAX_DOCUMENTS=100
ROUTER_MAX_INPUT_CHARACTERS=100000
# router/services/llm.py — maximum generated tokens for a routing response.
ROUTER_MAX_OUTPUT_TOKENS=4096

# ==========================================
# ACCOUNTS PAYABLE
# accounts_receivable/services/llm.py — shared service selects this module prefix.
# document_extraction/services/llm.py — provider credentials and HTTP transport.
