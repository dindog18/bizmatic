# ==========================================
# CONFIGURATION ASSISTANT (shared by AP and AR)
# accounts_receivable/services/assistant.py — builds proposals; never applies or submits them.
# accounts_receivable/services/llm.py and services/setup/ — all setup model calls use CONFIG_ASSISTANT_*.
# document_extraction/services/llm.py — provider credentials, base URLs and HTTP transport.
## LLM Provider
# Choose one chat provider: openai, anthropic, google, ollama, alibaba, or deepseek.
# Mistral OCR is not supported here because the assistant processes text.
CONFIG_ASSISTANT_LLM_PROVIDER=ollama

## Request Limits
# accounts_receivable/services/llm.py — request timeout, serialized input size and output tokens.
CONFIG_ASSISTANT_LLM_TIMEOUT_SECONDS=120
CONFIG_ASSISTANT_MAX_INPUT_CHARACTERS=150000
CONFIG_ASSISTANT_MAX_OUTPUT_TOKENS=8192

# Assistant provider and model settings are independent of AP/AR extraction.
# Blank API keys and base URLs reuse the matching DOC_EXTRACTION_* values.

## OpenAI
CONFIG_ASSISTANT_OPENAI_API_KEY=
CONFIG_ASSISTANT_OPENAI_MODEL=gpt-4o
CONFIG_ASSISTANT_OPENAI_BASE_URL=

## Anthropic
CONFIG_ASSISTANT_ANTHROPIC_API_KEY=
CONFIG_ASSISTANT_ANTHROPIC_MODEL=claude-sonnet-5-5
CONFIG_ASSISTANT_ANTHROPIC_BASE_URL=

## Google Gemini
CONFIG_ASSISTANT_GOOGLE_API_KEY=
CONFIG_ASSISTANT_GOOGLE_MODEL=gemini-3.8-flash
CONFIG_ASSISTANT_GOOGLE_BASE_URL=

## Ollama
CONFIG_ASSISTANT_OLLAMA_MODEL=qwen3-vl
CONFIG_ASSISTANT_OLLAMA_BASE_URL=

## Alibaba Cloud Model Studio
CONFIG_ASSISTANT_DASHSCOPE_API_KEY=
CONFIG_ASSISTANT_ALIBABA_MODEL=qwen3-vl-plus
CONFIG_ASSISTANT_ALIBABA_BASE_URL=

## DeepSeek
CONFIG_ASSISTANT_DEEPSEEK_API_KEY=
CONFIG_ASSISTANT_DEEPSEEK_MODEL=deepseek-flash
CONFIG_ASSISTANT_DEEPSEEK_BASE_URL=

## Configuration Assistant Terminal Logging
# bizmatic_django/settings.py — logger used by accounts_receivable/services/assistant.py.
# INFO, DEBUG, WARNING, or ERROR; logs IDs, provider/model, token counts and duration.
# Prompts, responses and credentials are not written to the terminal.
CONFIG_ASSISTANT_LOG_LEVEL=INFO
